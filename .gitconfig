[color]
	ui = true
[gitreview]
	username = ebbex
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	default = simple
[user]
	name = Erik Berg
	signingKey = 1182D19B0E5ED030
[commit]
	gpgSign = true
[alias]
	recommit = !git commit -eF $(git rev-parse --git-dir)/COMMIT_EDITMSG
[rebase]
	updateRefs = true
[rerere]
	enabled = false
[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://github.uio.no"]
	helper =
	helper = !/usr/bin/gh auth git-credential
