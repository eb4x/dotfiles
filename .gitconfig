[color]
	ui = true
[gitreview]
	username = ebbex
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	default = simple
[user]
	name = Erik Berg
	signingKey = 1182D19B0E5ED030
[commit]
	gpgSign = true
[alias]
	recommit = !git commit -eF $(git rev-parse --git-dir)/COMMIT_EDITMSG
[rebase]
	updateRefs = true
[rerere]
	enabled = true
# Written by `gh auth setup-git`. The empty helper resets the chain first, so
# nothing inherited from system config gets a look in. Needs `gh auth login`
# once per machine; without gh installed git just falls back to prompting.
[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
