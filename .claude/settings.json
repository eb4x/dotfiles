{
  "advisorModel": "claude-fable-5-2",
  "attribution": {
    "sessionUrl": false
  },
  "autoMemoryEnabled": false,
  "awaySummaryEnabled": false,
  "claudeMdExcludes": [
    "**/src/dotfiles/.claude/CLAUDE.md"
  ],
  "editorMode": "vim",
  "model": "claude-opus-5-5",
  "modelSettings": {
    "claude-fable-5-2": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "outputStyle": "Concise",
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "defaultMode": "default"
  },
  "remoteControlAtStartup": true,
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "git *",
      "gh *"
    ],
    "failIfUnavailable": true
  },
  "theme": "dark"
}
