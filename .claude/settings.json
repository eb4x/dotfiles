{
  "attribution": {
    "sessionUrl": false
  },
  "autoMemoryEnabled": false,
  "awaySummaryEnabled": false,
  "outputStyle": "Concise",
  "permissions": {
    "defaultMode": "default",
    "blockReadsOutsideWorkingDirectories": true
  },
  "remoteControlAtStartup": true,
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "excludedCommands": ["git *", "gh *"]
  },
  "theme": "dark"
}
