{
  "advisorModel": "claude-fable-5-2",
  "attribution": {
    "sessionUrl": false
  },
  "autoMemoryEnabled": false,
  "awaySummaryEnabled": false,
  "model": "claude-opus-5-5",
  "outputStyle": "Concise",
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "defaultMode": "default"
  },
  "remoteControlAtStartup": true,
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "git *",
      "gh *"
    ],
    "failIfUnavailable": true
  },
  "theme": "dark"
}
